    {
      "id": "elastic-00140285.evm",
      "title": "Potential Credential Access via Windows Utilities",
      "severity": "high",
      "etype": "process_create",
      "summary_contains": "",
      "patterns": [
        "procdump",
        "procdump.exe",
        "-ma",
        "ProcessDump.exe",
        ") or\n  (\n    (?process.pe.original_file_name :",
        "or process.name :",
        ") and\n      not process.parent.executable regex~",
        ") and\n      (\n        process.args :",
        "or\n        process.command_line : (",
        ")\n      )\n  ) or\n  (\n    (?process.pe.original_file_name :",
        ") and\n      process.args :",
        "and process.args :",
        ") and process.args :",
        "ProcessDump.exe\" and not process.parent.executable regex~ \"\"\"C:\\\\Program Files( \\(x86\\",
        "WriteMiniDump.exe",
        "RUNDLL32.exe"
      ],
      "match": "substring",
      "building_block": false,
      "enabled": true,
      "elastic_rule_id": "00140285-b827-4aee-aa09-8113f58a08f3",
      "precision_score": 67
    },
