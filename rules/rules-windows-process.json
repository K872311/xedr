      "severity": "high",
      "enabled": true,
      "nameEqualsAny": ["explorer.exe"],
      "pathNotContainsAny": ["\\windows\\explorer.exe"],
      "reason": "真 explorer 在 C:\\Windows\\explorer.exe，用户目录同名高度可疑。",
