{
  "meta": {
    "id": "file-scan-rules",
    "name": "文件扫描规则",
    "version": "3.0",
    "description": "原始规则严格降噪修正版：保留Public规则，收紧泛匹配并增强行为链",
    "optimization": "strict_noise_reduction_behavior_enhanced",
    "addedFields": [
      "confidence",
      "fpRisk",
      "attackStage",
      "mitre",
      "score"
    ]
  },
  "scanPaths": [
    {
      "path": "C:\\Program Files (x86)",
      "category": "程序文件(32位)",
      "maxDepth": 3,
      "followSymlinks": false
    },
    {
      "path": "C:\\ProgramData",
      "category": "程序数据",
      "maxDepth": 3,
      "followSymlinks": false
    },
    {
      "path": "C:\\Users",
      "category": "用户目录",
      "maxDepth": 4,
      "followSymlinks": false
    }
  ],
  "excludePatterns": [
    "node_modules",
    ".git",
    ".svn",
    "__pycache__",
    ".vs",
    "packages",
    "*.log",
    "*.tmp",
    "*.bak",
    "*.dmp",
    "thumbs.db",
    "desktop.ini",
    "*.lnk",
    ".ds_store",
    "\\OneDrive\\",
    "\\WindowsApps\\",
    "\\INetCache\\",
    "\\Package Cache\\",
    "\\Microsoft\\EdgeUpdate\\",
    "\\Google\\Chrome\\Application\\",
    "\\Mozilla Firefox\\",
    "\\VMware\\VMware Tools\\",
    "\\Huorong\\",
    "\\Windows Defender\\Definition Updates\\",
    "\\Microsoft\\WindowsApps\\"
  ],
  "fileCategories": {
    "executable": {
      "display": "可执行文件",
      "extensions": [
        ".exe",
        ".dll",
        ".sys",
        ".com",
        ".scr",
        ".pif",
        ".cpl",
        ".ocx",
        ".drv"
      ],
      "color": "#ef4444",
      "riskWeight": 3
    },
    "script": {
      "display": "脚本文件",
      "extensions": [
        ".ps1",
        ".bat",
        ".cmd",
        ".vbs",
        ".js",
        ".py",
        ".pl",
        ".rb",
        ".sh",
        ".wsf",
        ".jse",
        ".vbe"
      ],
      "color": "#f59e0b",
      "riskWeight": 2
    },
    "document": {
      "display": "文档",
      "extensions": [
        ".doc",
        ".docx",
        ".xls",
        ".xlsx",
        ".ppt",
        ".pptx",
        ".pdf",
        ".rtf",
        ".txt",
        ".csv",
        ".odt",
        ".ods",
        ".odp"
      ],
      "color": "#3b82f6",
      "riskWeight": 1
    },
    "archive": {
      "display": "压缩包",
      "extensions": [
        ".zip",
        ".rar",
        ".7z",
        ".tar",
        ".gz",
        ".bz2",
        ".xz",
        ".cab",
        ".arj",
        ".lzh",
        ".iso"
      ],
      "color": "#8b5cf6",
      "riskWeight": 2
    },
    "image": {
      "display": "图片",
      "extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".bmp",
        ".tif",
        ".tiff",
        ".ico",
        ".webp",
        ".svg"
      ],
      "color": "#06b6d4",
      "riskWeight": 0
    },
    "database": {
      "display": "数据库",
      "extensions": [
        ".db",
        ".sqlite",
        ".sqlite3",
        ".mdb",
        ".accdb",
        ".dbf",
        ".edb",
        ".pst",
        ".ost"
      ],
      "color": "#14b8a6",
      "riskWeight": 3
    },
    "config": {
      "display": "配置文件",
      "extensions": [
        ".ini",
        ".cfg",
        ".conf",
        ".config",
        ".xml",
        ".json",
        ".yaml",
        ".yml",
        ".reg",
        ".policy"
      ],
      "color": "#64748b",
      "riskWeight": 1
    },
    "certificate": {
      "display": "证书密钥",
      "extensions": [
        ".pfx",
        ".p12",
        ".pem",
        ".crt",
        ".key",
        ".der",
        ".cer",
        ".p7b",
        ".jks"
      ],
      "color": "#ec4899",
      "riskWeight": 4
    },
    "other": {
      "display": "其他",
      "extensions": [],
      "color": "#94a3b8",
      "riskWeight": 0
    }
  },
  "suspiciousRules": [
    {
      "name": "Temp目录可疑文件",
      "pathContains": "\\Temp\\",
      "pathNotContains": [
        "\\chocolatey\\",
        "\\nuget\\",
        "\\pip\\",
        "\\npm\\",
        "\\vs\\",
        "\\msbuild\\",
        "\\edge\\",
        "\\chrome\\",
        "\\winsxs\\"
      ],
      "extensions": [
        ".exe",
        ".ps1",
        ".vbs",
        ".scr"
      ],
      "sigStatus": "unsigned",
      "severity": "medium",
      "reason": "Temp 下无签名可执行/脚本（已降噪：去掉 bat/js，排除安装器缓存）"
    },
    {
      "id": "file.path.temp_cfg_drop",
      "name": "Temp 下 .cfg/GUID 目录投放可执行文件",
      "severity": "critical",
      "enabled": true,
      "pathContains": "\\Temp\\",
      "pathRegex": "(?i)\\\\temp\\\\([^\\\\]+\\.cfg|[0-9a-f]{8}-[0-9a-f-]{20,}|[0-9a-f~]{6,}\\.cfg)\\\\[^\\\\]+\\.(exe|dll|scr)$",
      "extensions": [
        ".exe",
        ".dll",
        ".scr"
      ],
      "reason": "AppData\\Local\\Temp 下以 .cfg 或 GUID 目录投放的 PE（银狐/代理马常见；进程退出后仍靠文件侧告警；含 NotTrusted 假签）",
      "mitre": [
        "T1036.005",
        "T1204.002",
        "T1546"
      ],
      "fpRisk": "low",
      "score": 90,
      "confidence": 90,
      "attackStage": "execution"
    },
    {
      "name": "用户目录启动项",
      "pathContainsAny": [
        "\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\",
        "\\Start Menu\\Programs\\Startup\\"
      ],
      "pathNotContains": [
        "\\PCManager\\",
        "\\Huawei\\",
        "\\WeMeet\\",
        "\\Tencent\\WeMeet\\",
        "\\WPS Office\\",
        "\\Kingsoft\\"
      ],
      "severity": "high",
      "reason": "真实 Windows 启动文件夹中的文件（排除厂商自建 *Startup* 目录误报）"
    },
    {
      "name": "双扩展名",
      "nameRegex": ".*\\.(.*?)\\.(exe|ps1|vbs|bat)$",
      "severity": "high",
      "reason": "双扩展名伪装文件"
    },
    {
      "name": "Public目录可执行文件",
      "pathContains": "\\Users\\Public\\",
      "pathNotContains": [
        "\\Public\\Desktop\\",
        "\\Public\\Libraries\\"
      ],
      "extensions": [
        ".exe",
        ".dll",
        ".vbs",
        ".ps1",
        ".scr"
      ],
      "sigStatus": "unsigned",
      "severity": "medium",
      "reason": "Users\\Public 下无签名可执行/脚本（去掉 bat/cmd 与公共桌面噪声）"
    },
    {
      "id": "custom.public.any.pe",
      "name": "Public目录及子目录可执行/脚本",
      "severity": "medium",
      "enabled": true,
      "pathContains": "\\Users\\Public\\",
      "pathNotContains": [
        "\\Public\\Libraries\\",
        "\\Public\\Documents\\",
        "\\OneDrive\\"
      ],
      "extensions": [
        ".exe",
        ".dll",
        ".sys",
        ".scr",
        ".com",
        ".bat",
        ".cmd",
        ".ps1",
        ".vbs",
        ".js"
      ],
      "reason": "Users\\Public 及子目录出现可执行/脚本即输出（不要求未签名）"
    },
    {
      "id": "custom.programdata.root.files",
      "name": "ProgramData根目录文件",
      "severity": "high",
      "enabled": true,
      "pathImmediateUnder": [
        "C:\\ProgramData"
      ],
      "extensions": [
        ".exe",
        ".dll",
        ".sys",
        ".scr",
        ".bat",
        ".cmd",
        ".ps1",
        ".vbs",
        ".js"
      ],
      "reason": "C:\\ProgramData 根下直接落盘文件（正常应在厂商子目录）"
    },
    {
      "id": "custom.appdata.local.root.files",
      "name": "AppData\\Local根目录未签名PE",
      "severity": "medium",
      "enabled": true,
      "pathRegex": "(?i)^[a-z]:\\\\users\\\\[^\\\\]+\\\\appdata\\\\local\\\\[^\\\\]+$",
      "extensions": [".exe", ".dll"],
      "requireExplicitUnsigned": true,
      "reason": "用户 AppData\\Local 根下直接落盘且明确未签名的 exe/dll",
      "confidence": 72,
      "fpRisk": "medium",
      "attackStage": "execution",
      "mitre": ["T1036", "T1204.002"],
      "score": 70
    },
    {
      "id": "custom.appdata.roaming.root.unsigned_pe",
      "name": "AppData\\Roaming根目录未签名PE",
      "severity": "medium",
      "enabled": true,
      "pathRegex": "(?i)^[a-z]:\\\\users\\\\[^\\\\]+\\\\appdata\\\\roaming\\\\[^\\\\]+$",
      "extensions": [".exe", ".dll"],
      "requireExplicitUnsigned": true,
      "reason": "用户 AppData\\Roaming 根下直接落盘且明确未签名的 exe/dll",
      "confidence": 72,
      "fpRisk": "medium",
      "attackStage": "execution",
      "mitre": ["T1036", "T1204.002"],
      "score": 70
    },
    {
      "id": "file.windows.bat.tasklist_pid_watchdog",
      "name": "Windows目录tasklist PID维权脚本",
      "severity": "high",
      "enabled": true,
      "extensions": [".bat", ".cmd"],
      "pathContains": "\\Windows\\",
      "pathNotContains": [
        "\\Windows\\System32\\",
        "\\Windows\\SysWOW64\\",
        "\\Windows\\WinSxS\\",
        "\\Windows\\Servicing\\",
        "\\Windows\\SoftwareDistribution\\",
        "\\Windows\\SystemApps\\"
      ],
      "stripCarets": true,
      "contentRegex": "(?is)tasklist\\s+/fi\\s+\"PID\\s+eq\\s+\\d+\"[\\s\\S]{0,400}?\\bnul\\b",
      "reason": "Windows 目录下 bat/cmd 经 caret 混淆后匹配 tasklist /fi \"PID eq <pid>\" … nul（典型进程维权看门狗）",
      "confidence": 93,
      "fpRisk": "low",
      "attackStage": "persistence",
      "mitre": ["T1053", "T1036.003", "T1543.003"],
      "score": 92
    },
    {
      "id": "custom.orphan.sys.dirty",
      "name": "脏目录驱动文件(.sys)",
      "severity": "high",
      "enabled": true,
      "extensions": [
        ".sys"
      ],
      "pathContainsAny": [
        "\\Users\\Public\\",
        "\\Temp\\",
        "\\tmp\\",
        "\\AppData\\",
        "\\ProgramData\\",
        "\\Downloads\\",
        "\\PerfLogs\\",
        "\\Drivers\\"
      ],
      "pathNotContains": [
        "\\Windows\\System32\\drivers\\",
        "\\Windows\\SysWOW64\\drivers\\",
        "\\Windows\\WinSxS\\"
      ],
      "reason": "非系统驱动目录下的 .sys（含未加载投放），常见于 BYOVD/临时驱动"
    },
    {
      "id": "file.dropper.drivers_dat",
      "name": "投放树标志-drivers.dat",
      "severity": "critical",
      "enabled": true,
      "nameRegex": "(?i)^drivers\\.dat(\\.[0-9]+)?$",
      "pathNotContains": [
        "\\Windows\\",
        "\\Program Files\\",
        "\\Program Files (x86)\\"
      ],
      "reason": "盘符根投放树标志文件 drivers.dat / drivers.dat.N（目录名不限 Drivers）",
      "confidence": 92,
      "fpRisk": "low",
      "attackStage": "persistence",
      "mitre": [
        "T1036",
        "T1204.002"
      ]
    },
    {
      "id": "file.dropper.drivers_tree_exe",
      "name": "投放树短随机子目录可执行文件",
      "severity": "critical",
      "enabled": true,
      "extensions": [
        ".exe",
        ".dll",
        ".scr",
        ".bat",
        ".cmd"
      ],
      "underDriversDatRoot": true,
      "requireUnsigned": true,
      "pathRegex": "(?i)^[a-z]:\\\\[^\\\\]+(?:\\\\[a-z0-9]{2,8}){1,8}\\\\[^\\\\]+$",
      "reason": "投放树根下短随机名子目录内的未签名可执行文件；已签 Valid 不告",
      "confidence": 90,
      "fpRisk": "low",
      "attackStage": "execution",
      "mitre": [
        "T1036",
        "T1059.003"
      ]
    },
    {
      "id": "file.dropper.nested_rand_invalid_sig",
      "name": "深层随机路径异常签名PE",
      "severity": "critical",
      "enabled": true,
      "extensions": [
        ".exe",
        ".dll",
        ".scr"
      ],
      "sigStatus": "invalid",
      "pathRegex": "(?i)^[a-z]:\\\\[^\\\\]+(?:\\\\[a-z0-9]{2,8}){2,}\\\\[^\\\\]+$",
      "pathNotContains": [
        "\\Windows\\",
        "\\Program Files\\",
        "\\Program Files (x86)\\",
        "\\ProgramData\\",
        "\\Users\\"
      ],
      "reason": "盘符根自定义目录下多层短随机子路径 + HashMismatch/NotTrusted 等异常签名 PE（如 C:\\bstlog\\lUgtB\\6T8YE\\bV8C\\x.exe）",
      "confidence": 93,
      "fpRisk": "low",
      "attackStage": "execution",
      "mitre": [
        "T1036",
        "T1553.002"
      ]
    },
    {
      "name": "银狐-DeviceSync",
      "pathContains": "\\ProgramData\\Microsoft\\DeviceSync\\",
      "severity": "critical",
      "reason": "银狐(SilverFox)典型落盘目录 DeviceSync"
    },
    {
      "name": "银狐-WindowsData",
      "pathContains": "\\ProgramData\\WindowsData\\",
      "severity": "critical",
      "reason": "银狐伪装 ProgramData\\WindowsData"
    },
    {
      "name": "银狐-dllcache",
      "pathContains": "\\AppData\\Roaming\\Microsoft\\Windows\\dllcache\\",
      "severity": "high",
      "reason": "假 dllcache 路径，正常系统不应出现用户侧 dllcache"
    },
    {
      "name": "银狐-MMC目录",
      "pathContains": "\\AppData\\Roaming\\Microsoft\\Windows\\mmc\\",
      "extensions": [
        ".exe",
        ".dll",
        ".bat",
        ".vbs",
        ".ps1"
      ],
      "severity": "high",
      "reason": "银狐常用 MMC 目录落盘"
    },
    {
      "name": "银狐-浏览器STP名",
      "nameRegex": "(?i)^(chromestp|edgestp|firefoxstp)\\.exe$",
      "severity": "high",
      "reason": "银狐伪装浏览器进程名 IOC"
    },
    {
      "name": "HollowQuill-RoamingDriver",
      "pathContains": "\\AppData\\Roaming\\Driver\\",
      "extensions": [
        ".exe",
        ".dll",
        ".bat",
        ".ps1",
        ".vbs",
        ".scr"
      ],
      "severity": "high",
      "reason": "AppData\\Roaming\\Driver 非标准子目录（HollowQuill）"
    },
    {
      "name": "双扩展LNK诱饵",
      "nameRegex": "(?i)\\.(rtf|doc|docx|pdf|xls|xlsx|ppt|pptx|txt|jpg|png)\\.lnk$",
      "severity": "high",
      "reason": "文档双扩展 LNK，ISO/VHD 钓鱼链常见"
    },
    {
      "name": "桌面下载磁盘镜像",
      "pathContains": "\\Users\\",
      "pathNotContains": [
        "\\Windows\\",
        "\\Program Files",
        "\\OneDrive\\"
      ],
      "nameRegex": "(?i)\\.(iso|vhd|vhdx|img)$",
      "severity": "medium",
      "reason": "用户目录磁盘镜像，可能为容器钓鱼入口（来源:0707 vhd_iso）"
    },
    {
      "name": "侧加载诱饵DLL-AppData",
      "pathContains": "\\AppData\\",
      "pathNotContains": [
        "\\OneDrive\\",
        "\\Microsoft\\",
        "\\Packages\\",
        "\\WindowsApps\\"
      ],
      "nameRegex": "(?i)^(version|dwmapi|winmm|wtsapi32|msimg32|textshaping|profapi|uxtheme|dbghelp|cryptsp|userenv|msctf|winhttp|cryptbase)\\.dll$",
      "severity": "high",
      "reason": "用户目录出现系统诱饵 DLL 名，DLL 侧加载高危"
    },
    {
      "name": "NarwhalRat-averwhale",
      "pathContains": "\\AppData\\Roaming\\averwhale\\",
      "severity": "high",
      "reason": "NarwhalRAT 伪装浏览器目录 averwhale"
    },
    {
      "name": "白象-WindowsDebug",
      "pathContains": "\\Windows\\Debug\\",
      "extensions": [
        ".exe",
        ".dll",
        ".bat",
        ".ps1"
      ],
      "severity": "high",
      "reason": "Windows\\Debug 下可执行/脚本（白象/Patchwork）"
    },
    {
      "name": "系统名伪装-用户目录",
      "pathContains": "\\Users\\",
      "pathNotContains": [
        "\\windows\\system32\\",
        "\\windows\\syswow64\\",
        "\\OneDrive\\"
      ],
      "nameRegex": "(?i)^(svchost|lsass|csrss|winlogon|services|smss|dwm|taskmgr|explorer|rundll32|system32|windows|system)\\.exe$",
      "severity": "high",
      "reason": "用户目录下系统进程名伪装"
    },
    {
      "name": "CS-Mimikatz工具名",
      "nameRegex": "(?i)(beacon|artifact)\\.(exe|dll)$|mimikatz|mimilib|mimidrv|sekurlsa",
      "severity": "high",
      "reason": "CobaltStrike/Mimikatz 等红队工具落盘特征"
    },
    {
      "name": "Unicode-RLO文件名",
      "nameRegex": "\\u202e",
      "severity": "high",
      "reason": "文件名含 RLO(U+202E) 用于扩展名伪装"
    },
    {
      "name": "APT-C-60载荷文件名",
      "nameRegex": "(?i)^(WebClassUser\\.dat|WebCacheR\\.tmp\\.dat|datapages\\.txt|datautils\\.txt|glog\\.txt)$",
      "severity": "high",
      "reason": "SpyGlace/APT-C-60 已知载荷文件名"
    },
    {
      "id": "file.ioc.astharot_comloader",
      "name": "Astharot/COMLoader 落地文件名",
      "nameRegex": "(?i)^(LoaderAstharotDll\\.dll|COMLoaderAstharot\\.exe|rs_beacon\\.bin|DataExchange_orig\\.dll)$",
      "severity": "critical",
      "enabled": true,
      "reason": "DataExchange CLSID 劫持（Astharot）公开落地文件名；优先查 Temp/ProgramData/用户目录",
      "mitre": ["T1546.015", "T1574"],
      "score": 96,
      "confidence": 96,
      "fpRisk": "low",
      "attackStage": "persistence"
    },
    {
      "id": "file.ioc.pdfwkrnl_sys",
      "name": "可疑驱动 pdfwkrnl.sys",
      "nameRegex": "(?i)^pdfwkrnl\\.sys$",
      "severity": "critical",
      "enabled": true,
      "reason": "浏览器扩展+NMH 木马报告中的恶意驱动文件名；需核对签名与来源",
      "mitre": ["T1543.003", "T1014"],
      "score": 95,
      "confidence": 94,
      "fpRisk": "low",
      "attackStage": "persistence"
    },
    {
      "id": "file.windows.root.unsigned_sys",
      "name": "Windows根目录无签名驱动(.sys)",
      "severity": "high",
      "enabled": true,
      "extensions": [".sys"],
      "pathImmediateUnder": ["C:\\Windows"],
      "pathRegex": "(?i)^[a-z]:\\\\windows\\\\[^\\\\]+\\.sys$",
      "requireExplicitUnsigned": true,
      "reason": "C:\\Windows\\ 根下直接落盘且无有效签名的 .sys（如 52hb.sys/st2.sys），常见于恶意驱动/BYOVD，非 Drivers 正规目录",
      "confidence": 92,
      "fpRisk": "low",
      "attackStage": "persistence",
      "mitre": ["T1014", "T1543.003"],
      "score": 92
    },
    {
      "id": "file.windows.drivers.unsigned_sys",
      "name": "Drivers目录无有效签名驱动",
      "severity": "medium",
      "enabled": true,
      "extensions": [".sys"],
      "pathContainsAny": [
        "\\Windows\\System32\\drivers\\",
        "\\Windows\\SysWOW64\\drivers\\"
      ],
      "pathNotContains": [
        "\\DriverStore\\",
        "\\WinSxS\\",
        "\\Windows\\System32\\DriverState\\"
      ],
      "requireExplicitUnsigned": true,
      "signerNotContainsAny": [
        "Microsoft Windows",
        "Microsoft Corporation",
        "Microsoft Windows Production",
        "Windows Hardware Compatibility"
      ],
      "companyNotContainsAny": [
        "Microsoft Corporation",
        "Microsoft Windows"
      ],
      "reason": "system32\\DRIVERS 下嵌入签名与目录签名均无效的 .sys（已排除微软/目录签仍有效）；样例 nv3dmp* 类未签驱动",
      "confidence": 78,
      "fpRisk": "medium",
      "attackStage": "persistence",
      "mitre": ["T1014"],
      "score": 72
    },
    {
      "id": "file.ioc.wefault_exe",
      "name": "仿 WerFault 载荷 wefault.exe",
      "nameRegex": "(?i)^wefault\\.exe$",
      "severity": "high",
      "enabled": true,
      "pathNotContains": [
        "\\Windows\\System32\\",
        "\\Windows\\SysWOW64\\"
      ],
      "reason": "文件名仿系统 WerFault.exe（少一字母），常见于 ProgramData 嵌入式 Python/窃密套件落盘",
      "confidence": 90,
      "fpRisk": "low",
      "attackStage": "execution",
      "mitre": ["T1036.005"],
      "score": 90
    },
    {
      "id": "file.apt.sipolicy_wdac_kill",
      "name": "恶意策略文件 SiPolicy.p7b",
      "severity": "critical",
