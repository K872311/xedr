      "id": "sunlogin",
      "name": "向日葵",
      "vendor": "贝锐 Oray",
      "priority": "high",
      "path_markers": ["\\oray\\awesun", "\\awesun", "\\sunlogin", "\\oray\\"],
      "exe_names": ["awesun.exe", "oldawesun.exe", "sunloginclient.exe", "awesun_guard.exe"],
      "service_names": ["awesunservice", "sunloginservice"],
      "signer_markers": ["贝锐", "shanghai best oray"],
      "product_markers": ["向日葵", "awesun", "sunlogin"],
      "config_globs": [
        "**/Oray/AweSun/config.ini",
        "**/Program Files/Oray/AweSun/config.ini",
        "**/ProgramData/Oray/AweSun/sys_config.ini"
      ],
      "history_globs": [
        "**/Oray/AweSun/log/history.log",
        "**/Program Files/Oray/AweSun/log/history.log"
      ],
      "session_log_globs": [
        "**/Oray/AweSun/log/desktop.agent.*.log",
        "**/Oray/AweSun/log/awesun_service.*.log"
      ],
      "parsers": {
        "config_client_id": {
          "ini_keys": ["fastcode", "clientId"]
        },
        "history": {
          "line_regex": "(?P<time>\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?P<peer>\\S+)\\s+(?P<action>开始|结束)(?P<kind>桌面控制|文件传输|远程协助)?(?:\\((?P<method>[^)]+)\\))?",
          "start_action": "开始",
          "end_action": "结束"
        },
        "service_session": {
          "start_regex": "OnReceive\\]\\s*Accept response control request",
          "p2p_regex": "login p2p server\\s*\\[(?P<relay>[^\\]]+)\\].*?public ip\\s+(?P<public_ip>[\\d.:]+).*?local ip\\s+(?P<local_ip>[\\d.:]+)",
          "peer_regex": "receive P2P request.*?public\\s+(?P<peer_public>[\\d.:]+)\\s+local\\s+(?P<peer_local>[\\d.:]+)",
          "account_regex": "\\[control\\]\\[logon\\]\\s*AccountName\\s+(?P<account>\\S+)",
          "tunnel_regex": "tunnel=MultiChannel\\([^)]*\\).*?ip=\\(forward:(?P<forward>[^,\\)]+)",
          "stop_regex": "OnPluginStoped\\]\\s*end controlled|mpstream\\]\\s*evt=stop&plugin=desktop"
        }
      }
    },
